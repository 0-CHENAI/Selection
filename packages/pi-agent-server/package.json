{
  "name": "@craft-agent/pi-agent-server",
  "version": "3.3.0",
  "license": "Apache-2.0",
  "description": "Out-of-process Pi agent server communicating via JSONL over stdio",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "pi-agent-server": "./dist/index.js"
  },
  "scripts": {
    "build": "bun run scripts/build.ts",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "validate": "bun run typecheck && bun run build"
  },
  "dependencies": {
    "@craft-agent/shared": "workspace:*",
    "fflate": "^0.8.2",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@earendil-works/pi-agent-core": "1.5.0",
    "@earendil-works/pi-ai": "1.5.0",
    "@silvia-odwyer/photon-node": "0.3.4",
    "@sinclair/typebox": "^0.34.0",
    "node-html-parser": "^6.1.0",
    "pdfjs-dist": "^5.4.0",
    "proper-lockfile": "4.1.2",
    "turndown": "^7.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/proper-lockfile": "4.1.4"
  }
}
