{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Selection OfficeCLI benchmark observations",
  "type": "object",
  "additionalProperties": false,
  "required": ["catalogHash", "observations"],
  "properties": {
    "catalogHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["taskId", "iteration", "model", "promptHash", "inputHash", "ok", "officeToolCalls", "duplicateStatusHelpCalls", "nativeCommands", "modelTotalDurationMs", "output", "internalGuideSkillEntries", "managementNetworkRequests"],
        "properties": {
          "taskId": { "type": "string" },
          "iteration": { "type": "integer", "minimum": 1 },
          "model": { "type": "string", "minLength": 1 },
          "promptHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "inputHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "ok": { "type": "boolean" },
          "officeToolCalls": { "type": "integer", "minimum": 0 },
          "duplicateStatusHelpCalls": { "type": "integer", "minimum": 0 },
          "nativeCommands": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["command", "durationMs"], "properties": { "command": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }, "durationMs": { "type": "number", "minimum": 0 } } } },
          "modelTotalDurationMs": { "type": "number", "minimum": 0 },
          "output": { "type": "object", "additionalProperties": false, "required": ["exists", "openable", "validated", "rendered", "currentRevisionEvidence", "deliveryReady"], "properties": { "exists": { "type": "boolean" }, "openable": { "type": "boolean" }, "validated": { "type": "boolean" }, "rendered": { "type": "boolean" }, "currentRevisionEvidence": { "type": "boolean" }, "deliveryReady": { "type": "boolean" } } },
          "internalGuideSkillEntries": { "type": "integer", "minimum": 0 },
          "managementNetworkRequests": { "type": "integer", "minimum": 0 },
          "manualMicrosoftOfficeGolden": { "enum": ["pass", "fail", "not-run"] }
        }
      }
    }
  }
}
