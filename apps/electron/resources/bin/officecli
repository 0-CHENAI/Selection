#!/bin/sh
# Selection wrapper — prefer the app-bundled binary, never curl-install.
# After create, or around heading / TOC writes, seed or repair Heading outlineLvl
# so Word can compile the TOC. Do not mutate on open / refresh / view.
DIR=$(CDPATH= cd -- "$(dirname "$0")" && pwd)
UNAME=$(uname -s 2>/dev/null || echo unknown)
MACHINE=$(uname -m 2>/dev/null || echo unknown)

case "$UNAME" in
  Darwin)
    ARCH=x64
    [ "$MACHINE" = "arm64" ] && ARCH=arm64
    CAND=$DIR/darwin-$ARCH/officecli
    ;;
  Linux)
    ARCH=x64
    [ "$MACHINE" = "aarch64" ] || [ "$MACHINE" = "arm64" ] && ARCH=arm64
    CAND=$DIR/linux-$ARCH/officecli
    ;;
  MINGW*|MSYS*|CYGWIN*|Windows_NT)
    CAND=$DIR/win32-x64/officecli.exe
    ;;
  *)
    CAND=""
    ;;
esac

if [ -n "$CAND" ] && [ -f "$CAND" ]; then
  BIN=$CAND
else
  echo "officecli is not bundled in this Selection build. Rebuild the app." >&2
  exit 127
fi

ENSURE=$DIR/officecli-ensure-docx-styles
SANITIZE=$DIR/../scripts/officecli-sanitize-metadata.js
BUN_BIN=""
if [ -x "$DIR/../../vendor/bun/bun" ]; then
  BUN_BIN=$DIR/../../vendor/bun/bun
fi

verb=""
docx=""
office_file=""
prev=""
ensure_before=0
ensure_after=0
for arg in "$@"; do
  case "$arg" in
    --*|-* ) ;;
    create|batch|save|close|add|set|remove|move|swap|refresh|raw-set|add-part|import|merge)
      [ -z "$verb" ] && verb=$arg
      [ "$arg" = "create" ] && ensure_after=1
      ;;
    *)
      if [ -z "$office_file" ]; then
        case "$arg" in
          *.docx|*.DOCX|*.docm|*.DOCM|*.xlsx|*.XLSX|*.xlsm|*.XLSM|*.pptx|*.PPTX) office_file=$arg ;;
        esac
      fi
      if [ -z "$docx" ]; then
        case "$arg" in
          *.docx|*.DOCX|*.docm|*.DOCM) docx=$arg ;;
        esac
      fi
      ;;
  esac
  case "$arg" in
    *style=Heading*|*style=Title*|*style=TOCHeading*|--type=toc) ensure_before=1 ;;
    *id=Heading*|*id=Title*|*id=TOCHeading*) ensure_after=1 ;;
  esac
  if [ "$prev" = "--type" ] && [ "$arg" = "toc" ]; then
    ensure_before=1
  fi
  prev=$arg
done

# merge reads the first Office file as a template and writes the second one.
# Attribution verification must target the output, not rewrite the template.
if [ "$verb" = "merge" ]; then
  office_file=""
  office_file_index=0
  for arg in "$@"; do
    case "$arg" in
      *.docx|*.DOCX|*.docm|*.DOCM|*.xlsx|*.XLSX|*.xlsm|*.XLSM|*.pptx|*.PPTX)
        office_file_index=$((office_file_index + 1))
        [ "$office_file_index" -eq 2 ] && office_file=$arg
        ;;
    esac
  done
fi

# Mutation verification must be available before OfficeCLI touches the file.
# Returning a failure only after create/add/batch has already committed is not
# fail-closed and encourages an unsafe automatic retry.
case "$verb" in
  create|batch|save|close|add|set|remove|move|swap|refresh|raw-set|add-part|import|merge)
    if [ -z "$office_file" ]; then
      echo "Selection could not identify the Office document before mutation." >&2
      exit 2
    fi
    if [ -z "$BUN_BIN" ] || [ ! -x "$BUN_BIN" ]; then
      echo "Selection's bundled Bun runtime is unavailable; attribution verification failed closed before mutation." >&2
      exit 127
    fi
    if [ ! -f "$SANITIZE" ]; then
      echo "Selection's OfficeCLI attribution verifier is unavailable; verification failed closed before mutation." >&2
      exit 127
    fi
    ;;
esac

ensure_docx() {
  if [ -n "$docx" ] && [ -f "$ENSURE" ] && [ -f "$docx" ]; then
    "$ENSURE" "$BIN" "$docx"
  fi
}

sanitize_office_file() {
  if [ -z "$office_file" ] || [ ! -f "$office_file" ]; then
    echo "Selection could not verify the Office document after mutation." >&2
    return 2
  fi
  if [ -z "$BUN_BIN" ] || [ ! -x "$BUN_BIN" ]; then
    echo "Selection's bundled Bun runtime is unavailable; attribution verification failed closed." >&2
    return 127
  fi
  if [ ! -f "$SANITIZE" ]; then
    echo "Selection's OfficeCLI attribution verifier is unavailable; verification failed closed." >&2
    return 127
  fi
  "$BUN_BIN" "$SANITIZE" "$office_file" "$@"
  return $?
}

close_before_package_rewrite() {
  [ "$verb" = "close" ] && return 0
  "$BIN" close "$office_file" --json >/dev/null
  return $?
}

if [ "$verb" = "create" ]; then
  "$BIN" "$@"
  status=$?
  [ $status -eq 0 ] && ensure_docx
  if [ $status -eq 0 ]; then
    close_before_package_rewrite
    status=$?
  fi
  if [ $status -eq 0 ]; then
    sanitize_office_file
    status=$?
  fi
  exit $status
fi

if [ "$ensure_before" = 1 ] || [ "$ensure_after" = 1 ]; then
  [ "$ensure_before" = 1 ] && ensure_docx
  "$BIN" "$@"
  status=$?
  [ $status -eq 0 ] && [ "$ensure_after" = 1 ] && ensure_docx
  if [ $status -eq 0 ]; then
    close_before_package_rewrite
    status=$?
  fi
  if [ $status -eq 0 ]; then
    sanitize_office_file
    status=$?
  fi
  exit $status
fi

case "$verb" in
  save|close)
    "$BIN" "$@"
    status=$?
    if [ $status -eq 0 ]; then
      close_before_package_rewrite
      status=$?
    fi
    if [ $status -eq 0 ]; then
      sanitize_office_file --inspect-visible
      status=$?
    fi
    exit $status
    ;;
  batch|add|set|remove|move|swap|refresh|raw-set|add-part|import|merge)
    "$BIN" "$@"
    status=$?
    if [ $status -eq 0 ]; then
      close_before_package_rewrite
      status=$?
    fi
    if [ $status -eq 0 ]; then
      sanitize_office_file
      status=$?
    fi
    exit $status
    ;;
esac

exec "$BIN" "$@"
